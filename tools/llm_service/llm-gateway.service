# Домашний сервер (Linux): systemd-юнит для шлюза (приватный вход в LLM).
# Установка:
#   sudo cp llm-gateway.service /etc/systemd/system/llm-gateway.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now llm-gateway
# Ключ и лимиты — в /etc/default/llm-gateway (EnvironmentFile).
[Unit]
Description=Private LLM gateway (auth + rate limit + context cap)
After=network-online.target ollama.service
Wants=ollama.service

[Service]
Type=simple
WorkingDirectory=/opt/llm_service
EnvironmentFile=-/etc/default/llm-gateway
ExecStart=/usr/bin/python3 /opt/llm_service/gateway.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
